{
  "openapi": "3.1.0",
  "info": {
    "title": "ACC GitHub Publishing Bridge",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.github.com"
    }
  ],
  "paths": {
    "/repos/vitalydz/btc2g.github.io/issues": {
      "post": {
        "operationId": "submitAccJob",
        "summary": "Submit an owner-authorized ACC publishing job",
        "description": "Create only titles beginning ACC: and body containing <!-- acc-job:v1 --> plus one fenced JSON object. Actions: handshake, push, pages, workflow. Require explicit user intent to publish. Never put credentials in the body.",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "body"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job issue created; this is not proof of execution",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listAccIssues",
        "summary": "List ACC job issues; ignore pull requests",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Issues",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/repos/vitalydz/btc2g.github.io/issues/{issue_number}": {
      "get": {
        "operationId": "getAccJob",
        "summary": "Read job before reporting or requesting approval",
        "parameters": [
          {
            "name": "issue_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Issue",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/repos/vitalydz/btc2g.github.io/issues/{issue_number}/comments": {
      "get": {
        "operationId": "getAccJobStatus",
        "summary": "Read runner receipts; DISPATCHED is not deployed",
        "parameters": [
          {
            "name": "issue_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status comments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/repos/vitalydz/btc2g.github.io/commits/{ref}": {
      "get": {
        "operationId": "resolveGitHubCommit",
        "summary": "Resolve a remote branch or SHA before publishing; local push SHA must come from the actual local commit",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Commit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/repos/vitalydz/btc2g.github.io/actions/runs": {
      "get": {
        "operationId": "getWorkflowRuns",
        "summary": "Inspect workflow results, not just dispatch acceptance",
        "parameters": [
          {
            "name": "branch",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow runs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/repos/vitalydz/btc2g.github.io/pages/builds/latest": {
      "get": {
        "operationId": "getLatestPagesBuild",
        "summary": "Check deployed commit and Pages build status",
        "responses": {
          "200": {
            "description": "Latest build",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "githubToken": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "githubToken": []
    }
  ]
}